    "@elysiajs/openapi": "^1.4.16",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5"
  },
  "private": true,
  "type": "module"
}

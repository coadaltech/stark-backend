{
  "name": "stark-backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc",
    "test": "bun test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",

PORT=8000
DATABASE_URL=postgres://stark:stark@localhost:5433/stark
CORS_ORIGIN=http://localhost:3000
DB_TIMEZONE=Asia/Kolkata
# Developer (platform) account created by: bun run db:seed:developer
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=change-me
# Token signing secrets, at least 32 characters each and different: openssl rand -base64 48
# JWT_ACCESS_SECRET must match the frontend (.env.local).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Host (with port in development) of the main app; organization sites use their own domains.
MAIN_APP_HOST=localhost:3000
